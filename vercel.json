{
  "builds": [],
  "routes": [
    {
      "src": "/chartly/assets/(.*)",
      "dest": "/chartly/assets/$1"
    },
    {
      "src": "/chartly/public/themes/(.*)\\.json",
      "dest": "/chartly/themes/$1.json"
    },
    {
      "src": "/chartly/100000/(.*)\\.geoJson",
      "dest": "/chartly/100000/$1.geoJson"
    },
    {
      "src": "/chartly/100000/(.*)/(.*)\\.geoJson",
      "dest": "/chartly/100000/$1/$2.geoJson"
    },
    {
      "src": "/chartly/area.json",
      "dest": "/chartly/area.json"
    },
    {
      "src": "/chartly/favicon.ico",
      "dest": "/chartly/favicon.ico"
    },
    {
      "src": "/chartly/(.*)\\.(?:js|css|map|png|jpg|jpeg|svg|webp|gif|json|ico|woff2?|ttf)$",
      "dest": "/chartly/$1"
    },
    {
      "src": "/chartly/?$",
      "dest": "/chartly/index.html"
    },
    {
      "src": "/chartly/(.*)",
      "dest": "/chartly/index.html"
    },
    {
      "src": "/_nuxt/(.*)",
      "dest": "/website/_nuxt/$1"
    },
    {
      "src": "/(.*)\\.(?:js|css|map|png|jpg|jpeg|svg|webp|gif|json|ico|woff2?|ttf)$",
      "dest": "/website/$1"
    },
    {
      "src": "/?$",
      "dest": "/website/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/website/index.html"
    }
  ]
}
